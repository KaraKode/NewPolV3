        </td>
        <td><input type="text" name="desavantages.{{index}}.description" value="{{desavantage.description}}" /></td>
        <td class="polaris-colonne-action">
          <button type="button" data-action="retirerLigne" data-liste="desavantages" data-index="{{index}}"
                  data-tooltip="{{localize 'POLARIS.Action.supprimer'}}">
            <i class="fa-solid fa-trash"></i>
          </button>
        </td>
      </tr>
    {{else}}
      <tr><td colspan="4" class="polaris-vide">{{localize "POLARIS.Message.aucunItem"}}</td></tr>
    {{/each}}
  </tbody>
