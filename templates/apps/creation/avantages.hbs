<button type="button" class="polaris-bouton-ajout-large" data-action="ajouterLigne" data-liste="desavantages">
  <i class="fa-solid fa-plus"></i>
  {{localize "POLARIS.Creation.ajouterDesavantage"}}
</button>

<p class="polaris-aide">{{localize "POLARIS.Creation.Aide.traitsEnItems"}}</p>
