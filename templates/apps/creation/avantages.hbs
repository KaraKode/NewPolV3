<table class="polaris-table polaris-table-creation">
  <thead>
    <tr>
      <th>{{localize "POLARIS.Genre.desavantage"}}</th>
      <th class="polaris-colonne-nombre">{{localize "POLARIS.Creation.cout"}}</th>
      <th>{{localize "POLARIS.Champ.description"}}</th>
      <th class="polaris-colonne-action"></th>
    </tr>
  </thead>
  <tbody>
    {{#each donnees.desavantages as |desavantage index|}}
      <tr>
        <td><input type="text" name="desavantages.{{index}}.nom" value="{{desavantage.nom}}" /></td>
        <td class="polaris-colonne-nombre">
          <input type="number" name="desavantages.{{index}}.cout" value="{{desavantage.cout}}"
